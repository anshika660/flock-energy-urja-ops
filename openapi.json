                  "type": "null"
                }
              ],
              "description": "Filter by build hardware: 'legacy' or 'v2'",
              "title": "Build"
            },
            "description": "Filter by build hardware: 'legacy' or 'v2'"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Distribution Transformer code (e.g. DT-001)",
              "title": "Dt Code"
            },
            "description": "Filter by Distribution Transformer code (e.g. DT-001)"
          },
          {
            "name": "feeder_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
