              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hierarchy/tree": {
      "get": {
        "tags": [
          "Network Hierarchy"
        ],
        "summary": "Get reconstructed electrical network hierarchy tree",
        "description": "Reconstructs the hierarchical topology: Discom -> Zone -> Circle -> Division -> Subdivision -> Substation -> Feeder -> DT -> Meters. Automatically resolves legacy naming and coding inconsistencies.",
        "operationId": "get_hierarchy_tree_api_v1_hierarchy_tree_get",
        "responses": {
          "200": {
            "description": "Successful Response",
