{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops Gateway API",
    "description": "Production-grade, high-performance REST API gateway in front of the legacy Urja Meter Ops smart-metering portal. Exposes normalized meter fleet records, reconstructed electrical network hierarchies, interval energy analytics, and geospatial querying.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List and search smart meters",
        "description": "Query meters across multiple attributes. Supports partial text search on meter ID or serial, filtering by manufacturer, phase type, installation status, transformer code, feeder code, etc.",
        "operationId": "list_meters_api_v1_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring search on meterId or serialNo",
              "title": "Q"
            },
            "description": "Substring search on meterId or serialNo"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by meter manufacturer (e.g. HPL, L&T, Genus, Secure, Allied)",
              "title": "Make"
            },
            "description": "Filter by meter manufacturer (e.g. HPL, L&T, Genus, Secure, Allied)"
          },
          {
            "name": "phase_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by phase: 'single' or 'three'",
              "title": "Phase Type"
            },
            "description": "Filter by phase: 'single' or 'three'"
          },
          {
            "name": "install_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by status: 'Installed', 'Faulty', 'Decommissioned'",
              "title": "Install Status"
            },
            "description": "Filter by status: 'Installed', 'Faulty', 'Decommissioned'"
          },
          {
            "name": "install_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by install type: 'Whole Current' or 'CT Operated'",
              "title": "Install Type"
            },
            "description": "Filter by install type: 'Whole Current' or 'CT Operated'"
