    "/api/v1/meters/{meter_id}/energy": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter energy consumption readings",
        "description": "Retrieve chronological 30-minute interval readings for a meter (kWh, kVAh, voltage). Includes computed window summary analytics: net consumption, power factor, voltage min/avg/max.",
        "operationId": "get_meter_energy_api_v1_meters__meter_id__energy_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          },
          {
            "name": "include_summary",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Whether to include aggregated summary metrics",
              "default": true,
              "title": "Include Summary"
            },
            "description": "Whether to include aggregated summary metrics"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 1000,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum readings to return",
              "title": "Limit"
            },
            "description": "Maximum readings to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterEnergyResponse"
                }
              }
            }
